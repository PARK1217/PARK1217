# docker compose가 읽는 값. 복사해서 .env 로 쓴다.

# 호스트(LXC)에서 열 포트. 컨테이너 안은 항상 8080이고 이 값으로 매핑만 바꾼다.
HOST_PORT=8080
# 서비스 도메인. Cloudflare Tunnel 뒤에 둘 서브도메인 (미정이면 비워 둔다)
APP_DOMAIN=fridge.chobihome.com
# 시간대. 식단 기록의 '오늘'과 14일 범위 계산에 쓴다
TZ=Asia/Seoul
# 로컬 개발에서 Cloudflare Access 헤더가 없을 때 쓰는 사용자 (배포에서는 무시된다)
DEV_USER_EMAIL=local@dev
